# Copy to .env and fill in. Local runs: node --env-file=.env src/cli.js scan
# GitHub Actions reads these from repo Secrets/Variables instead.

# Public base URL of the deployed index (no trailing slash).
CARTSIGNAL_BASE_URL=https://your-project.pages.dev

# Where the weekly digest goes.
CARTSIGNAL_OWNER_EMAIL=you@yourdomain.com

# Verified sender in Resend. Until a domain is verified, use onboarding@resend.dev.
CARTSIGNAL_FROM=CartSignal <reports@yourdomain.com>

# Brand string used in the index, digest, and delivery emails.
CARTSIGNAL_BRAND=CartSignal

# Gmail SMTP (preferred when both are set). Use a Google app password, not your Gmail password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Resend fallback (free tier: 100 emails/day).
RESEND_API_KEY=

# Worker only:
STRIPE_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
